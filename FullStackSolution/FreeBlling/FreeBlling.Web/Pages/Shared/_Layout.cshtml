<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Free Billing - @ViewBag.Title</title>
    <link rel="stylesheet" href="/dist/aspnet-validation.css" />
    <link rel="stylesheet" href="site.css" asp-append-version="true" />
    @RenderSection("header", false)
</head>
<body>
    <header class="flex 
                   justify-between
                    w-full
                    bg-blue-900
                    text-white
                    p-3">
        <h1 class="font-bold text-2xl"><i class="fa-solid fa-file-invoice-dollar"></i> Free Billing</h1>
        <ul class="flex text-blue-300">
            <li class="mx-2 hover:text-blue-500"><a href="/">Home</a></li>
            <li class="mx-2 hover:text-blue-500"><a href="/Contact">Contact</a></li>
        </ul>
    </header>
    <div class="bg-gray-100 p-2 w-full h-[calc(100vh-75px)] overflow-auto">
        @RenderBody()
    </div>
    <footer class="text-center bg-black text-white">&copy; 2026 Free Billing</footer>
    <script src="/dist/aspnet-validation.js"></script>
    @RenderSection("scripts", false)
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/js/all.min.js" integrity="sha512-6BTOlkauINO65nLhXhthZMtepgJSghyimIalb+crKRPhvhmsCdnIuGcVbR5/aQY2A+260iC1OPy1oCdB6pSSwQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</body>
</html>
