@page
@model FreeBlling.Web.Pages.IndexModel
@{
    // var productName = "Free Billing Services";
    // throw new InvalidOperationException("bad things happen to good developers.");
    ViewBag.Title = "Home Page";
}
    <h1>Free Billing</h1>
    <p>Free Billing is a solution for billing for small companies and individuals</p>

    @if(Model.Customers is not null && Model.Customers.Count() > 0)
    {
    <ul>
        @foreach(var customer in Model.Customers)
        {
            <li>@customer.CompanyName</li>    
        }
    </ul>
    }
    else
    {
        <div>No Customer Found...</div>
    }

